{
  "name": "dinobrain",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "description": "DinoBrain MCP server and app",
  "bin": {
    "dinobrain-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "flow:audit": "node scripts/audit-user-flow.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "eval:context": "node dist/evaluate-context.js",
    "eval:behavior": "node dist/evaluate-behavior.js",
    "graph:health": "node dist/build-graph-health.js",
    "graph:health:verify": "node scripts/verify-graph-health.mjs",
    "graph:vault": "node scripts/export-vault-graph.mjs",
    "hook:verify": "node scripts/verify-codex-hook.mjs",
    "installer:win": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "installer:verify:version": "powershell -ExecutionPolicy Bypass -File scripts/verify-installer-version-alignment.ps1",
    "installer:verify:approval": "powershell -ExecutionPolicy Bypass -File scripts/verify-codex-hook-approval.ps1",
    "uninstall:verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-uninstall.ps1",
    "release:win": "powershell -ExecutionPolicy Bypass -File scripts/publish-github-release.ps1",
    "index:operations": "node dist/build-operations-index.js",
    "index:sqlite": "node dist/build-sqlite-shards.js",
    "index:verify:sqlite": "node scripts/verify-sqlite-shards.mjs",
    "index:verify:operations": "node scripts/verify-operations-index.mjs",
    "index:verify": "node scripts/verify-wiki-index.mjs",
    "index:wiki": "node dist/build-wiki-index.js",
    "observatory": "node scripts/dinobrain-observatory.mjs",
    "observatory:verify": "node scripts/verify-observatory-live-graph.mjs",
    "session:verify": "node scripts/verify-session-ingest.mjs",
    "verify:os": "node scripts/verify-dinobrain-os.mjs",
    "verify:compounding": "node scripts/verify-compounding-loop.mjs",
    "verify:v2": "node scripts/verify-v2-os.mjs",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke-mcp.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^5.0.0"
  }
}
