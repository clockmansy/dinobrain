{
  "name": "dinobrain",
  "version": "2.2.9",
  "private": true,
  "type": "module",
  "description": "DinoBrain MCP server and app",
  "bin": {
    "dinobrain-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "node scripts/verify-version-authority.mjs && tsc -p tsconfig.json",
    "version:verify": "node scripts/verify-version-authority.mjs",
    "completion:audit": "node dist/run-completion-audit.js",
    "completion:audit:verify": "node scripts/verify-completion-audit.mjs",
    "atomic:writers:verify": "node scripts/verify-atomic-state-writers.mjs",
    "status:generation:verify": "node scripts/verify-status-generation.mjs",
    "audit:full-memory": "node dist/build-full-memory-audit.js",
    "audit:full-memory:verify": "node scripts/verify-full-memory-audit.mjs",
    "flow:audit": "node scripts/audit-user-flow.mjs",
    "check": "node scripts/verify-version-authority.mjs && tsc -p tsconfig.json --noEmit",
    "status:refresh": "node dist/refresh-status-artifacts.js",
    "status:health": "node dist/build-health-status.js",
    "status:mcp-direct": "node dist/build-client-mcp-direct-status.js",
    "verify:mcp-direct": "node scripts/verify-client-mcp-direct-status.mjs",
    "proof:mcp:challenge": "node dist/create-client-mcp-proof-challenge.js",
    "proof:mcp:codex": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-client-mcp-proof.ps1 -Agent codex",
    "proof:mcp:claude": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-client-mcp-proof.ps1 -Agent claude",
    "status:native-authority": "node dist/build-native-instruction-authority.js",
    "verify:native-authority": "node scripts/verify-native-instruction-authority.mjs",
    "status:source-lineage": "node dist/build-source-lineage-status.js",
    "verify:source-lineage": "node scripts/verify-source-lineage.mjs",
    "source:lineage:migrate": "node dist/build-source-lineage-transactions.js",
    "source:lineage:rollback": "node dist/build-source-lineage-transactions.js --rollback",
    "source:lineage:reapply": "node dist/build-source-lineage-transactions.js --reapply",
    "source:lineage:transaction:verify": "node scripts/verify-source-lineage-transaction.mjs",
    "status:behavior-recall": "node dist/build-behavior-recall-status.js",
    "status:compounding": "node dist/build-controlled-compounding-status.js",
    "behavior:recall:migrate": "node dist/build-behavior-recall-migration.js",
    "behavior:recall:migrate:apply": "node dist/build-behavior-recall-migration.js --apply",
    "behavior:recall:migrate:rollback": "node dist/build-behavior-recall-migration.js --rollback",
    "behavior:recall:migrate:verify": "node scripts/verify-behavior-recall-migration.mjs",
    "verify:behavior-recall": "node scripts/verify-behavior-recall.mjs",
    "status:freshness": "node dist/build-status-freshness.js",
    "status:freshness:verify": "node scripts/verify-status-freshness.mjs",
    "review:settle": "node dist/build-review-settlement.js",
    "review:settle:verify": "node scripts/verify-review-settlement.mjs",
    "review:worklist": "node dist/build-review-worklist.js",
    "review:worklist:verify": "node scripts/verify-review-worklist.mjs",
    "review:worklist:actions": "node dist/build-review-worklist-actions.js",
    "review:worklist:actions:verify": "node scripts/verify-review-worklist-actions.mjs",
    "review:backpressure": "node dist/build-review-backpressure.js",
    "review:backpressure:verify": "node scripts/verify-review-backpressure.mjs",
    "cold:partitions": "node dist/build-cold-partitions.js",
    "cold:partitions:apply": "node dist/build-cold-partitions.js --apply",
    "cold:partitions:verify": "node scripts/verify-cold-partitions.mjs",
    "memory:lifecycle": "node dist/build-node-lifecycle.js",
    "memory:lifecycle:apply": "node dist/build-node-lifecycle.js --apply",
    "memory:lifecycle:rollback": "node dist/build-node-lifecycle.js --rollback",
    "memory:lifecycle:verify": "npm run build --silent && node scripts/verify-node-lifecycle.mjs",
    "task:lifecycle": "node dist/build-task-lifecycle.js",
    "task:lifecycle:verify": "node scripts/verify-task-lifecycle.mjs",
    "task:lifecycle:settle": "node dist/build-task-lifecycle-settlement.js",
    "task:lifecycle:settle:verify": "node scripts/verify-task-lifecycle-settlement.mjs",
    "task:finish:stdio": "node scripts/finish-task-stdio.mjs",
    "eval:context": "node dist/evaluate-context.js",
    "eval:behavior": "node dist/evaluate-behavior.js",
    "rag:proof": "node dist/build-rag-proof.js",
    "rag:proof:verify": "node scripts/verify-rag-proof.mjs",
    "rag:vector:migration": "node dist/build-vector-index-migration.js",
    "rag:vector:migration:rollback": "node dist/build-vector-index-migration.js --rollback",
    "rag:vector:migration:reapply": "node dist/build-vector-index-migration.js --reapply",
    "rag:vector:migration:verify": "node scripts/verify-vector-index-migration.mjs",
    "rag:retrieval:verify": "node scripts/verify-contextual-hybrid-retrieval.mjs",
    "eval:rag": "node dist/build-rag-eval.js",
    "eval:rag:verify": "node scripts/verify-rag-eval.mjs",
    "status:live-semantic-query": "node dist/build-live-semantic-query-status.js",
    "verify:live-semantic-query": "node scripts/verify-live-semantic-query.mjs",
    "verify:live-query-cache-budget": "node scripts/verify-live-query-cache-budget.mjs",
    "verify:semantic-pipeline-cache": "node scripts/verify-semantic-pipeline-cache.mjs",
    "status:answer-quality": "node dist/build-answer-quality-status.js",
    "verify:answer-quality": "node scripts/verify-answer-quality.mjs",
    "scale:50k": "node dist/build-scale-proof.js",
    "scale:50k:check": "node scripts/verify-scale-proof-current.mjs",
    "scale:50k:verify": "npm run build --silent && node scripts/verify-scale-proof.mjs",
    "status:release-manifest": "node dist/build-release-manifest-status.js",
    "verify:release-manifest": "node scripts/verify-release-manifest.mjs",
    "graph:health": "node dist/build-graph-health.js",
    "graph:health:verify": "node scripts/verify-graph-health.mjs",
    "graph:vault": "node scripts/export-vault-graph.mjs",
    "hook:verify": "node scripts/verify-codex-hook.mjs",
    "prompt:eligibility:verify": "node scripts/verify-prompt-eligibility.mjs",
    "pre-response:gate:verify": "node scripts/verify-pre-response-action-gate.mjs",
    "installer:win": "powershell -ExecutionPolicy Bypass -File scripts/build-windows-installer.ps1",
    "installer:verify:version": "powershell -ExecutionPolicy Bypass -File scripts/verify-installer-version-alignment.ps1",
    "installer:verify:path-ux": "powershell -ExecutionPolicy Bypass -File scripts/verify-installer-path-ux.ps1",
    "installer:verify:approval": "powershell -ExecutionPolicy Bypass -File scripts/verify-codex-hook-approval.ps1",
    "installer:verify:launchers": "powershell -ExecutionPolicy Bypass -File scripts/verify-installer-observatory-launcher.ps1",
    "installer:verify:managed-hook": "powershell -ExecutionPolicy Bypass -File scripts/verify-codex-managed-hook.ps1",
    "installer:verify:semantic-rag": "powershell -ExecutionPolicy Bypass -File scripts/verify-installer-semantic-rag.ps1",
    "codex:hooks:approval": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-codex-hook-approval.ps1 -RestartStaleCodex -RestartStaleMcp",
    "codex:hooks:diagnose": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/diagnose-codex-hook.ps1",
    "codex:hooks:managed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-codex-managed-hook.ps1 -Elevate",
    "codex:live-proof": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-codex-live-proof.ps1 -Detached",
    "uninstall:verify": "powershell -ExecutionPolicy Bypass -File scripts/verify-uninstall.ps1",
    "release:win": "powershell -ExecutionPolicy Bypass -File scripts/publish-github-release.ps1",
    "sources:rag:seed": "node scripts/seed-rag-source-anchors.mjs --write",
    "session:promote": "node scripts/promote-codex-session-knowledge.mjs --write",
    "session:promote:check": "node scripts/promote-codex-session-knowledge.mjs",
    "chatgpt:import": "npm run build --silent && node scripts/import-chatgpt-export.mjs --write",
    "chatgpt:import:check": "npm run build --silent && node scripts/import-chatgpt-export.mjs",
    "chatgpt:import:verify": "npm run build --silent && node scripts/verify-chatgpt-export-import.mjs",
    "memory:migrate:unreviewed": "node scripts/migrate-unreviewed-auto-generated-accepted.mjs",
    "hooks:data:install": "powershell -ExecutionPolicy Bypass -File scripts/install-data-git-hooks.ps1",
    "hooks:data:verify": "node scripts/verify-data-git-hooks.mjs",
    "safety:public-data": "node scripts/verify-public-data-safety.mjs --write",
    "safety:public-data:check": "node scripts/verify-public-data-safety.mjs",
    "index:operations": "node dist/build-operations-index.js",
    "index:sqlite": "node dist/build-sqlite-shards.js",
    "index:verify:sqlite": "node scripts/verify-sqlite-shards.mjs",
    "index:verify:operations": "node scripts/verify-operations-index.mjs",
    "index:verify:concurrency": "node scripts/verify-operations-concurrency.mjs",
    "index:verify": "node scripts/verify-wiki-index.mjs",
    "index:wiki": "node dist/build-wiki-index.js",
    "observatory": "node scripts/dinobrain-observatory.mjs",
    "observatory:verify": "node scripts/verify-observatory-live-graph.mjs",
    "verify:observatory-evidence": "node scripts/verify-observatory-live-graph.mjs",
    "session:verify": "node scripts/verify-session-ingest.mjs",
    "verify:os": "node scripts/verify-dinobrain-os.mjs",
    "verify:codex-live": "node scripts/verify-codex-live-preflight.mjs",
    "verify:codex-live:recent": "node scripts/verify-codex-live-preflight.mjs --require-snippet=false",
    "verify:codex-mcp-preflight": "node scripts/verify-codex-mcp-preflight-proof.mjs",
    "verify:codex-loop": "node scripts/verify-codex-closed-loop.mjs",
    "verify:goal": "node scripts/verify-closed-loop-goal.mjs",
    "verify:compounding": "node scripts/verify-compounding-loop.mjs",
    "verify:v2": "node scripts/verify-v2-os.mjs",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke-mcp.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^5.0.0"
  }
}
