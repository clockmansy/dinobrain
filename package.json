{
  "name": "dinobrain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DinoBrain MCP server and app",
  "bin": {
    "dinobrain-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "flow:audit": "node scripts/audit-user-flow.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "eval:context": "node dist/evaluate-context.js",
    "graph:vault": "node scripts/export-vault-graph.mjs",
    "hook:verify": "node scripts/verify-codex-hook.mjs",
    "index:operations": "node dist/build-operations-index.js",
    "index:sqlite": "node dist/build-sqlite-shards.js",
    "index:verify:sqlite": "node scripts/verify-sqlite-shards.mjs",
    "index:verify:operations": "node scripts/verify-operations-index.mjs",
    "index:verify": "node scripts/verify-wiki-index.mjs",
    "index:wiki": "node dist/build-wiki-index.js",
    "observatory": "node scripts/dinobrain-observatory.mjs",
    "verify:os": "node scripts/verify-dinobrain-os.mjs",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke-mcp.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "typescript": "^5.0.0"
  }
}
