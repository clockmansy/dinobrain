<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DinoBrainSetup</AssemblyName>
    <RootNamespace>DinoBrainSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>0.1.0</Version>
    <Authors>DinoBrain</Authors>
    <Description>DinoBrain Windows installer bootstrapper</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\install.ps1" LogicalName="install.ps1" />
  </ItemGroup>
</Project>
