<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DinoBrainSetup</AssemblyName>
    <RootNamespace>DinoBrainSetup</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <Version>2.2.32</Version>
    <SetupVersion Condition="'$(SetupVersion)' == ''">2.2.32</SetupVersion>
    <InstallerAppRef Condition="'$(InstallerAppRef)' == ''">main</InstallerAppRef>
    <InstallerDataRef Condition="'$(InstallerDataRef)' == ''">main</InstallerDataRef>
    <Authors>DinoBrain</Authors>
    <Description>DinoBrain Windows installer bootstrapper</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\install.ps1" LogicalName="install.ps1" />
    <EmbeddedResource Include="$(BaseIntermediateOutputPath)observatory-launcher\DinoBrain Observatory.exe" LogicalName="observatory-launcher.exe" />
  </ItemGroup>

  <Target Name="PublishObservatoryLauncher" BeforeTargets="CoreCompile">
    <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\DinoBrainObservatoryLauncher\DinoBrainObservatoryLauncher.csproj&quot; --configuration $(Configuration) --runtime $(RuntimeIdentifier) --self-contained true -p:PublishSingleFile=true --no-restore --output &quot;$(BaseIntermediateOutputPath)observatory-launcher&quot;" />
  </Target>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SetupVersion</_Parameter1>
      <_Parameter2>$(SetupVersion)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>InstallerAppRef</_Parameter1>
      <_Parameter2>$(InstallerAppRef)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>InstallerDataRef</_Parameter1>
      <_Parameter2>$(InstallerDataRef)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
</Project>
