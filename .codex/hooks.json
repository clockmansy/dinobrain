{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/scripts/dinobrain-user-prompt-hook.mjs\"",
            "commandWindows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -Command \"& { $root = git rev-parse --show-toplevel; & (Join-Path $root 'scripts\\dinobrain-user-prompt-hook.ps1') }\"",
            "timeout": 30,
            "statusMessage": "Loading DinoBrain context"
          }
        ]
      }
    ]
  }
}
